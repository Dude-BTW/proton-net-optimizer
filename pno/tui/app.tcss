Screen {
    layout: vertical;
}

#status-bar {
    height: 3;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
}

#status-text {
    width: 1fr;
    padding: 1 0;
    color: $text-muted;
}

#pause-btn,
#refresh-btn,
#disconnect-btn {
    width: auto;
    min-width: 12;
    margin-left: 1;
}

#disconnect-btn {
    min-width: 14;
}

/* Catppuccin Mocha: keep in sync with pno/tui/theme.py. */
#current-info {
    width: 1fr;
    height: auto;
    min-height: 1;
    padding: 0 1;
    margin-bottom: 1;
    background: #1e1e2e;
}

#tabs {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

#servers-layout {
    height: 1fr;
}

#servers-filters,
#secure-filters {
    height: auto;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
}

#servers-filters Input,
#secure-filters Input {
    width: 1fr;
}

#servers-filters Checkbox,
#secure-filters Checkbox {
    width: auto;
    margin-left: 2;
}

#servers-filters Static,
#secure-filters Static {
    width: auto;
    min-width: 12;
    margin-left: 2;
    color: $text-muted;
}

#servers-tables {
    height: 1fr;
}

#country-table {
    width: 2fr;
    height: 1fr;
    border: round $accent;
}

#server-pane {
    width: 3fr;
    height: 1fr;
    margin-left: 1;
}

#servers-tables #country-table {
    width: 2fr;
}

#server-table {
    height: 1fr;
    border: round $accent;
}

#server-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#servers-hint {
    width: 1fr;
    padding: 1 1;
    color: $text-muted;
}

#secure-layout {
    height: 1fr;
}

#secure-table {
    height: 1fr;
    border: round $accent;
}

#secure-actions {
    height: auto;
    padding: 1 0;
}

GuiConflictScreen {
    align: center middle;
    background: $background 60%;
}

#gui-dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#gui-dialog-title {
    text-style: bold;
    color: $error;
    padding-bottom: 1;
}

#gui-dialog-message {
    padding-bottom: 1;
}

#gui-dialog-detail {
    color: $text-muted;
    padding-bottom: 1;
}

#gui-dialog-actions {
    height: auto;
    align: right middle;
}

#gui-dialog-actions Button {
    margin-left: 2;
}

RequirementsScreen {
    align: center middle;
    background: $background 60%;
}

#requirements-dialog {
    width: 90;
    height: auto;
    max-height: 30;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#requirements-title {
    text-style: bold;
    color: $warning;
    padding-bottom: 1;
}

#requirements-body {
    max-height: 20;
    overflow-y: auto;
    padding-bottom: 1;
}

#requirements-actions {
    height: auto;
    align: right middle;
}

#requirements-actions Button {
    margin-left: 2;
}

#favorites-layout {
    height: 1fr;
    padding: 0 1;
}

#favorites-hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#favorites-panels {
    height: 1fr;
}

#favorites-visual-panel {
    width: 3fr;
    height: 1fr;
    padding-right: 1;
}

#favorites-text-panel {
    width: 2fr;
    height: 1fr;
    padding-left: 1;
}

.favorites-title {
    height: 1;
    text-style: bold;
    color: $text-muted;
}

#favorites-filters {
    height: auto;
    align: left middle;
}

#favorites-filters Checkbox {
    width: auto;
    margin-right: 2;
}

#favorites-list {
    height: 1fr;
    border: round $accent;
}

#favorites-text {
    height: 1fr;
    border: round $accent;
}

#favorites-visual-status,
#favorites-text-status {
    height: auto;
    min-height: 1;
    color: $text-muted;
}

#favorites-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#favorites-actions Button {
    margin-right: 2;
}

#autoconnect-layout {
    height: 1fr;
    padding: 0 1;
}

#autoconnect-hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#autoconnect-enabled {
    width: auto;
    margin-top: 1;
}

#autoconnect-current {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text-muted;
}

#autoconnect-panels {
    height: 1fr;
}

#autoconnect-visual-panel {
    width: 3fr;
    height: 1fr;
    padding-right: 1;
}

#autoconnect-text-panel {
    width: 2fr;
    height: 1fr;
    padding-left: 1;
}

.autoconnect-title {
    height: 1;
    text-style: bold;
    color: $text-muted;
}

#autoconnect-list {
    height: 1fr;
    border: round $accent;
}

#autoconnect-text {
    height: 1fr;
    border: round $accent;
}

#autoconnect-visual-status,
#autoconnect-text-status {
    height: auto;
    min-height: 1;
    color: $text-muted;
}

#autoconnect-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#autoconnect-actions Button {
    margin-right: 2;
}

#favorites-status {
    width: 1fr;
    padding: 1 0;
    color: $text-muted;
}

#mirror-layout {
    height: 1fr;
}

#mirror-info {
    height: auto;
    padding: 1 1;
    border: round $accent;
    margin-bottom: 1;
}

#mirror-table {
    height: 1fr;
    border: round $accent;
}

#mirror-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#auto-mirror {
    width: auto;
    margin-right: 2;
}

#logs-layout {
    height: 1fr;
}

#log-controls {
    height: auto;
    align: left middle;
    padding: 0 1;
}

#log-controls Label {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#log-controls Input {
    width: 8;
}

#log-stats {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#log-view {
    height: 1fr;
    border: round $accent;
    padding: 0 1;
}

#settings-layout {
    height: 1fr;
    padding: 1 2;
}

#settings-layout Label {
    margin-top: 1;
    color: $text-muted;
}

#settings-layout Input,
#settings-layout Select {
    width: 40;
}

#settings-layout Checkbox {
    width: 40;
    margin-top: 1;
}

#settings-favorites-hint {
    margin-top: 0;
    color: $text-muted;
}

#settings-save-btn {
    margin-top: 2;
    width: 20;
}

#proton-tab {
    height: 1fr;
}

#proton-banner {
    height: auto;
    min-height: 0;
    padding: 0 2;
    color: $warning;
    text-style: bold;
}

#proton-layout {
    height: 1fr;
    padding: 1 2;
    align: center top;
}

.proton-card {
    width: 1fr;
    max-width: 80;
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: solid $proton-border;
}

#proton-card-account {
    background: $proton-bg-account;
}

#proton-card-features {
    background: $proton-bg-features;
}

#proton-card-connection {
    background: $proton-bg-connection;
}

#proton-card-general {
    background: $proton-bg-general;
}

#proton-card-gui {
    background: $proton-bg-gui;
}

.proton-section {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    text-style: bold;
    color: $accent;
}

.proton-field {
    width: 100%;
    height: auto;
    padding: 1 0;
    border-bottom: solid $proton-border;
}

.proton-label {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

.proton-help {
    width: 100%;
    height: auto;
    color: $text-muted;
}

#proton-killswitch-clean-btn {
    width: 100%;
    margin-top: 1;
}

#proton-layout Select,
#proton-layout Input,
#proton-layout TextArea,
#proton-layout Checkbox {
    width: 100%;
}

#proton-layout Input,
#proton-layout TextArea,
#proton-layout Checkbox,
#proton-layout SelectCurrent {
    border: tall $proton-border;
    background: transparent;
}

#proton-layout Input:focus,
#proton-layout TextArea:focus,
#proton-layout Checkbox:focus,
#proton-layout Select:focus > SelectCurrent {
    border: tall $accent;
}

#proton-account-row {
    height: auto;
    align: left middle;
}

#proton-account {
    width: 1fr;
    padding: 0;
}

#proton-manage-btn {
    width: 24;
}

#proton-account-help {
    width: 100%;
}

#proton-split-apps {
    height: 6;
}

#proton-split-actions {
    height: auto;
    padding-top: 1;
}

#proton-actions-row {
    width: 1fr;
    height: auto;
    align: center middle;
}

#proton-actions {
    width: 1fr;
    max-width: 80;
    height: auto;
    padding: 1 0;
    border-top: solid $proton-border;
    align: left middle;
}

#proton-actions Button {
    width: 20;
    margin-right: 2;
}

#proton-status {
    width: 1fr;
    padding: 0 1;
    color: $text-muted;
}

#proton-gui-app,
#proton-gui-help {
    width: 100%;
}

RunningAppScreen {
    align: center middle;
    background: $background 60%;
}

#running-app-dialog {
    width: 90;
    height: auto;
    max-height: 30;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#running-app-title {
    text-style: bold;
    padding-bottom: 1;
}

#running-app-search {
    margin-bottom: 1;
}

#running-app-list {
    height: 15;
    border: round $accent;
}

#running-app-empty {
    height: auto;
    min-height: 1;
    color: $text-muted;
    padding: 0 1;
}

#running-app-actions {
    height: auto;
    align: right middle;
    padding-top: 1;
}

#running-app-actions Button {
    margin-left: 2;
}
