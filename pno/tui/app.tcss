Screen {
    layout: vertical;
}

#status-bar {
    height: 3;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
}

#status-text {
    width: 1fr;
    padding: 1 0;
    color: $text-muted;
}

#pause-btn,
#refresh-btn,
#disconnect-btn {
    width: auto;
    min-width: 12;
    margin-left: 1;
}

#disconnect-btn {
    min-width: 14;
}

/* Catppuccin Mocha: keep in sync with pno/tui/theme.py. */
#current-info {
    width: 1fr;
    height: auto;
    min-height: 1;
    padding: 0 1;
    margin-bottom: 1;
    background: #1e1e2e;
}

#tabs {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

#servers-layout {
    height: 1fr;
}

#servers-filters,
#secure-filters {
    height: auto;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
}

#servers-filters Input,
#secure-filters Input {
    width: 1fr;
}

#servers-filters Checkbox,
#secure-filters Checkbox {
    width: auto;
    margin-left: 2;
}

#servers-filters Static,
#secure-filters Static {
    width: auto;
    min-width: 12;
    margin-left: 2;
    color: $text-muted;
}

#servers-tables {
    height: 1fr;
}

#country-table {
    width: 2fr;
    height: 1fr;
    border: round $accent;
}

#server-pane {
    width: 3fr;
    height: 1fr;
    margin-left: 1;
}

#servers-tables #country-table {
    width: 2fr;
}

#server-table {
    height: 1fr;
    border: round $accent;
}

#server-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#servers-hint {
    width: 1fr;
    padding: 1 1;
    color: $text-muted;
}

#secure-layout {
    height: 1fr;
}

#secure-table {
    height: 1fr;
    border: round $accent;
}

#secure-actions {
    height: auto;
    padding: 1 0;
}

GuiConflictScreen {
    align: center middle;
    background: $background 60%;
}

#gui-dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#gui-dialog-title {
    text-style: bold;
    color: $error;
    padding-bottom: 1;
}

#gui-dialog-message {
    padding-bottom: 1;
}

#gui-dialog-detail {
    color: $text-muted;
    padding-bottom: 1;
}

#gui-dialog-actions {
    height: auto;
    align: right middle;
}

#gui-dialog-actions Button {
    margin-left: 2;
}

RequirementsScreen {
    align: center middle;
    background: $background 60%;
}

#requirements-dialog {
    width: 90;
    height: auto;
    max-height: 30;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#requirements-title {
    text-style: bold;
    color: $warning;
    padding-bottom: 1;
}

#requirements-body {
    max-height: 20;
    overflow-y: auto;
    padding-bottom: 1;
}

#requirements-actions {
    height: auto;
    align: right middle;
}

#requirements-actions Button {
    margin-left: 2;
}

#mirror-layout {
    height: 1fr;
}

#mirror-info {
    height: auto;
    padding: 1 1;
    border: round $accent;
    margin-bottom: 1;
}

#mirror-table {
    height: 1fr;
    border: round $accent;
}

#mirror-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#auto-mirror {
    width: auto;
    margin-right: 2;
}

#log-view {
    height: 1fr;
    border: round $accent;
    padding: 0 1;
}

#settings-layout {
    height: 1fr;
    padding: 1 2;
}

#settings-layout Label {
    margin-top: 1;
    color: $text-muted;
}

#settings-layout Input,
#settings-layout Select {
    width: 40;
}

#settings-save-btn {
    margin-top: 2;
    width: 20;
}
